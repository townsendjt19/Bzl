#splash-banner {
    height: 5;
    content-align: center middle;
}

#logo-header {
    height: 2;
    padding: 0 1;
}

#thinking-indicator {
    height: 1;
    padding: 0 1;
}

#top-row {
    height: auto;
}

#project-panel, #git-panel {
    width: 1fr;
    border: solid $primary;
    padding: 1;
}

#providers-panel {
    height: auto;
    border: solid $primary;
    padding: 1;
}

#activity-log {
    height: 1fr;
    border: solid $primary;
}

#command-bar > .input--cursor {
    background: transparent;
    color: $text;
    text-style: underline;
}
